#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"

WorldInfo {
  basicTimeStep 32
}
Viewpoint {
  orientation 0.26 0.93 0.25 1.95
  position 11 8 12
}
TexturedBackground {
  skyColor [ 0.55 0.70 0.90 ]
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 20 20
  wallHeight 0.15
  floorTileSize 1 1
}

# Road markings / reference objects
Solid {
  translation 0 0.01 -4
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.95 0.75 0.10 roughness 0.8 }
      geometry Box { size 0.15 0.02 1.0 }
    }
  ]
  name "road_marking_1"
}
Solid {
  translation 0 0.01 0
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.95 0.75 0.10 roughness 0.8 }
      geometry Box { size 0.15 0.02 1.0 }
    }
  ]
  name "road_marking_2"
}

# Front obstacle
Solid {
  translation 0 0.65 -7.0
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.85 0.15 0.08 roughness 0.6 }
      geometry Box { size 3.0 1.3 0.7 }
    }
    Shape {
      appearance PBRAppearance { baseColor 0.08 0.08 0.08 roughness 0.5 }
      geometry Box { size 2.4 0.25 0.05 }
      translation 0 0.15 0.36
    }
  ]
  name "front_obstacle"
  boundingObject Box { size 3.0 1.3 0.7 }
}

# Rear reference obstacle
Solid {
  translation 0 0.65 7.0
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.12 0.30 0.75 roughness 0.6 }
      geometry Box { size 3.0 1.3 0.7 }
    }
  ]
  name "rear_obstacle"
  boundingObject Box { size 3.0 1.3 0.7 }
}

DEF SAFETY_CAR Robot {
  supervisor TRUE
  translation 0 0.35 4.5
  controller "vehicle_safety_controller"
  children [
    # Main body
    Shape {
      appearance PBRAppearance {
        baseColor 0.10 0.22 0.42
        roughness 0.35
        metalness 0.15
      }
      geometry Box { size 2.0 0.55 3.2 }
    }
    # Roof
    Shape {
      translation 0 0.48 0
      appearance PBRAppearance {
        baseColor 0.75 0.85 0.95
        roughness 0.2
        metalness 0.05
      }
      geometry Box { size 1.55 0.25 1.6 }
    }
    # Front bumper
    Shape {
      translation 0 0.05 -1.72
      appearance PBRAppearance { baseColor 0.04 0.04 0.04 roughness 0.7 }
      geometry Box { size 2.05 0.20 0.18 }
    }
    # Rear bumper
    Shape {
      translation 0 0.05 1.72
      appearance PBRAppearance { baseColor 0.04 0.04 0.04 roughness 0.7 }
      geometry Box { size 2.05 0.20 0.18 }
    }
    # Wheels
    Shape {
      translation -1.05 0 -1.05
      rotation 1 0 0 1.5708
      appearance PBRAppearance { baseColor 0.02 0.02 0.02 roughness 0.9 }
      geometry Cylinder { radius 0.48 height 0.28 }
    }
    Shape {
      translation 1.05 0 -1.05
      rotation 1 0 0 1.5708
      appearance PBRAppearance { baseColor 0.02 0.02 0.02 roughness 0.9 }
      geometry Cylinder { radius 0.48 height 0.28 }
    }
    Shape {
      translation -1.05 0 1.05
      rotation 1 0 0 1.5708
      appearance PBRAppearance { baseColor 0.02 0.02 0.02 roughness 0.9 }
      geometry Cylinder { radius 0.48 height 0.28 }
    }
    Shape {
      translation 1.05 0 1.05
      rotation 1 0 0 1.5708
      appearance PBRAppearance { baseColor 0.02 0.02 0.02 roughness 0.9 }
      geometry Cylinder { radius 0.48 height 0.28 }
    }

    # Front ultrasonic sensor
    DistanceSensor {
      name "front_ultrasonic"
      type "sonar"
      translation 0 0.12 -1.82
      rotation 0 1 0 3.14159
      lookupTable [ 0 1000 0, 10 0 0 ]
    }
    # Rear ultrasonic sensor
    DistanceSensor {
      name "rear_ultrasonic"
      type "sonar"
      translation 0 0.12 1.82
      rotation 0 1 0 0
      lookupTable [ 0 1000 0, 10 0 0 ]
    }

    # MPU6050-equivalent virtual IMU
    Accelerometer {
      name "mpu_accelerometer"
      translation 0 0.55 0
    }
    Gyro {
      name "mpu_gyro"
      translation 0 0.55 0
    }

    # OLED-equivalent display
    Display {
      name "oled"
      width 320
      height 180
    }

    # Status LEDs
    LED { name "green_led" }
    LED { name "yellow_led" }
    LED { name "red_led" }

    # LDR is represented by a software light-level mode in this 3D prototype.
    # Keyboard L toggles NORMAL/LOW LIGHT.
  ]
}
